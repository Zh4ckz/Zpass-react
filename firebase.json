{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "passgram",
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "!.well-known",
      "!.well-known/**",
      "**/node_modules/**",
      "resources/js/vendor/qrcode-generator.js",
      "**/*.tmp*",
      "**/*.old",
      "**/*.bin",
      "**/*.apk",
      "**/*.exe",
      "**/*.zip"
    ],
    "rewrites": [
      {
        "source": "/favicon.ico",
        "destination": "/resources/img/favicon.ico"
      },
      {
        "source": "/login",
        "destination": "/_next/static/chunks/d71645980be6b1b2.html"
      },
      {
        "source": "/login/**",
        "destination": "/_next/static/chunks/d71645980be6b1b2.html"
      },
      {
        "source": "/web",
        "destination": "/_next/static/chunks/d71645980be6b1b2.html"
      },
      {
        "source": "/web/**",
        "destination": "/_next/static/chunks/d71645980be6b1b2.html"
      },
      {
        "source": "/api",
        "destination": "/_next/static/chunks/3bd42b31dc4e8baa.html"
      },
      {
        "source": "/*",
        "destination": "/profile.html"
      }
    ],
    "headers": [
      {
        "source": "/web",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/web/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/checkout",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/checkout.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/_next/static/chunks/d71645980be6b1b2.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/_next/static/chunks/d71645980be6b1b2",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/_next/static/chunks/e6dd7c91fbc053a6.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/_next/static/chunks/e6dd7c91fbc053a6",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/resources/js/checkout-session.mjs",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/resources/js/pay-checkout.mjs",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/profile.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/resources/js/profile-routing.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/premium",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/subdomain/api",
        "destination": "https://api.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/api/**",
        "destination": "https://api.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/bots",
        "destination": "https://bots.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/bots/**",
        "destination": "https://bots.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/core",
        "destination": "https://core.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/core/**",
        "destination": "https://core.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/docs",
        "destination": "https://docs.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/docs/**",
        "destination": "https://docs.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/pay",
        "destination": "https://pay.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/pay/**",
        "destination": "https://pay.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/web",
        "destination": "https://web.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/web/**",
        "destination": "https://web.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/developers",
        "destination": "https://developers.zpas.org/",
        "type": 301
      },
      {
        "source": "/subdomain/developers/**",
        "destination": "https://developers.zpas.org/",
        "type": 301
      },
      {
        "source": "/premium_sign_up",
        "destination": "/premium",
        "type": 301
      },
      {
        "source": "/premium_sign_up.html",
        "destination": "/premium",
        "type": 301
      }
    ]
  }
}
