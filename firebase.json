{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "passgram",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "apps/**",
      "**/*.tmp*",
      "**/*.old",
      "**/*.bin",
      "**/*.apk",
      "**/*.exe",
      "**/*.zip"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/web.html"
      },
      {
        "source": "/login/**",
        "destination": "/web.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
