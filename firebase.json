{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "passgram",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "apps/**",
      "**/*.tmp*",
      "**/*.old",
      "**/*.bin",
      "**/*.apk",
      "**/*.exe",
      "**/*.zip"
    ],
    "rewrites": [
      {
        "source": "/setlanguage",
        "destination": "/setlanguage.html"
      },
      {
        "source": "/setlanguage/**",
        "destination": "/setlanguage.html"
      },
      {
        "source": "/login",
        "destination": "/web.html"
      },
      {
        "source": "/login/**",
        "destination": "/web.html"
      },
      {
        "source": "/web",
        "destination": "/web.html"
      },
      {
        "source": "/web/**",
        "destination": "/web.html"
      },
      {
        "source": "**",
        "destination": "/translations.html"
      }
    ]
  }
}
