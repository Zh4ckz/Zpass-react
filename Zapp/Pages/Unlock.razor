@page "/unlock"
@inject AppState AppState
@inject Zapp.Security.PortableCloudCrypto Crypto
@inject NavigationManager Nav

<PageTitle>Unlock Vault — Zapp</PageTitle>

<div class="center-screen">
    <div class="auth-card">
        @if (_checking)
        {
            <h1 class="auth-title">Checking account...</h1>
        }
        else if (_showCodePanel)
        {
            <h1 class="auth-title">Enter your vault unlock code</h1>
            <p class="auth-subtitle">Open Z Pass on your phone → Authenticator tab, and enter the 6-digit code pinned at the top. It refreshes every 30 seconds.</p>

            <label class="field-label">6-digit code</label>
            <input class="input code-input" maxlength="6" @bind="_code" @bind:event="oninput" @onkeydown="OnCodeKeyDown" />

            @if (!string.IsNullOrEmpty(_codeError))
            {
                <p class="error-text">@_codeError</p>
            }

            <button class="btn btn-primary" disabled="@_busy" @onclick="VerifyCodeAsync">
                @(_busy ? "Unlocking..." : "Unlock")
            </button>
            <button class="btn btn-ghost" style="margin-top:10px" @onclick="() => _showCodePanel = false">
                Use recovery password instead
            </button>
        }
        else
        {
            <h1 class="auth-title">Unlock your vault</h1>
            <p class="auth-subtitle">Enter the recovery password you set up on your Z Pass mobile app. It never leaves this device — it's only used to derive the keys that decrypt your vault.</p>

            <label class="field-label">Recovery password</label>
            <input class="input" type="password" @bind="_recoveryPassword" @bind:event="oninput" @onkeydown="OnManualKeyDown" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="error-text">@_error</p>
            }

            <button class="btn btn-primary" disabled="@_busy" @onclick="() => UnlockAsync(_recoveryPassword)">
                @(_busy ? "Unlocking..." : "Unlock")
            </button>
            @if (_webLoginSecret is not null)
            {
                <button class="btn btn-ghost" style="margin-top:10px" @onclick="() => _showCodePanel = true">
                    Use vault unlock code instead
                </button>
            }
        }
    </div>
</div>

@code {
    private bool _checking = true;
    private bool _showCodePanel;
    private bool _busy;
    private string _code = "";
    private string _recoveryPassword = "";
    private string? _error;
    private string? _codeError;
    private string? _webLoginSecret;

    protected override async Task OnInitializedAsync()
    {
        if (AppState.SessionHolder is null || AppState.Firestore is null)
        {
            Nav.NavigateTo("/");
            return;
        }
        try
        {
            var status = await WebLoginAuth.FetchStatusAsync(AppState.Firestore, AppState.SessionHolder.Uid);
            if (status.Enabled)
            {
                _webLoginSecret = status.Secret;
                _showCodePanel = true;
            }
        }
        catch { /* fall back to manual recovery password */ }
        _checking = false;
    }

    private async Task OnCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await VerifyCodeAsync();
    }

    private async Task OnManualKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UnlockAsync(_recoveryPassword);
    }

    private async Task VerifyCodeAsync()
    {
        if (_webLoginSecret is null) return;
        if (!TotpEngine.VerifyCode(_webLoginSecret, _code))
        {
            _codeError = "Code is incorrect or expired. Enter the current code from your phone's Authenticator tab.";
            return;
        }
        _codeError = null;
        _busy = true;
        try
        {
            await UnlockAsync(_webLoginSecret);
        }
        catch (VaultUnlockException)
        {
            _showCodePanel = false;
            _error = "This code doesn't match this vault's original recovery key. Enter your recovery password instead.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UnlockAsync(string recoveryPassword)
    {
        if (recoveryPassword.Length < 10)
        {
            _error = "Recovery password must be at least 10 characters.";
            return;
        }
        _error = null;
        _busy = true;
        try
        {
            var repository = new VaultRepository(AppState.Firestore!, Crypto, AppState.SessionHolder!.Uid);
            var cipher = await repository.ResolveCipherAsync(recoveryPassword);
            AppState.Repository = repository;
            AppState.Cipher = cipher;
            AppState.RecoveryPassword = recoveryPassword;
            Nav.NavigateTo("/vault");
        }
        catch (VaultUnlockException ex)
        {
            _error = ex.Message;
            throw;
        }
        catch (Exception ex)
        {
            _error = $"Could not unlock the vault: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
