@page "/"
@inject AppState AppState
@inject NavigationManager Nav
@inject LocalPasscodeStore PasscodeStore
@inject IJSRuntime JS

<PageTitle>Sign in — Zapp</PageTitle>

<div class="center-screen">
    <div class="auth-card">
        <img class="auth-logo" src="icon-192.png" alt="" />
        <h1 class="auth-title">Zapp</h1>
        <p class="auth-subtitle">Sign in with your Z Pass account</p>

        @if (_checkingSavedSession)
        {
            <p class="status-text">Checking for a saved session...</p>
        }
        else
        {
            @if (_forgotPasswordMode)
            {
                <label class="field-label">Email</label>
                <input class="input" @bind="_email" @bind:event="oninput" @onkeydown="OnForgotKeyDown" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error-text">@_error</p>
                }
                @if (!string.IsNullOrEmpty(_status))
                {
                    <p class="status-text" style="margin-bottom:14px">@_status</p>
                }

                <button class="btn btn-primary" disabled="@_busy" @onclick="SendResetEmailAsync">
                    @(_busy ? "Sending..." : "Send reset link")
                </button>
                <button class="btn btn-ghost" style="margin-top:10px" @onclick="() => _forgotPasswordMode = false">
                    Back to sign in
                </button>
            }
            else
            {
                <label class="field-label">Email</label>
                <input class="input" @bind="_email" @bind:event="oninput" @onkeydown="OnKeyDown" />

                <label class="field-label">Password</label>
                <input class="input" type="password" @bind="_password" @bind:event="oninput" @onkeydown="OnKeyDown" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error-text">@_error</p>
                }

                <button class="btn btn-primary" disabled="@_busy" @onclick="SignInAsync">
                    @(_busy ? "Signing in..." : "Sign in")
                </button>

                <div class="divider">or</div>

                <button class="btn btn-ghost" disabled="@_busy" style="margin-bottom:10px" @onclick='() => SignInWithProviderAsync("google")'>
                    Continue with Google
                </button>

                <button class="btn btn-ghost" style="margin-top:10px" @onclick="ShowForgotPassword">
                    Forgot your password?
                </button>

                <p class="status-text">@_status</p>
            }
        }
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private string _status = "";
    private bool _busy;
    private bool _forgotPasswordMode;
    private bool _checkingSavedSession = true;

    protected override async Task OnInitializedAsync()
    {
        AppState.Clear();
        if (await PasscodeStore.HasSavedSessionAsync())
        {
            Nav.NavigateTo("/quick-unlock");
            return;
        }
        _checkingSavedSession = false;
    }

    private void ShowForgotPassword()
    {
        _forgotPasswordMode = true;
        _error = null;
        _status = "";
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignInAsync();
    }

    private async Task OnForgotKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendResetEmailAsync();
    }

    private async Task SignInAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Enter your email and password.";
            return;
        }

        _busy = true;
        _status = "Signing in...";
        try
        {
            var auth = new FirebaseAuthClient(AppConfig.FirebaseApiKey);
            var session = await auth.SignInWithPasswordAsync(_email.Trim(), _password);
            AppState.SessionHolder = new SessionHolder(auth, session);
            AppState.Firestore = new FirestoreClient(AppConfig.FirebaseProjectId, AppState.SessionHolder.GetValidIdTokenAsync);
            Nav.NavigateTo("/unlock");
        }
        catch (FirebaseAuthException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach Firebase: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _status = "";
        }
    }

    private sealed class OAuthResult
    {
        public string IdToken { get; set; } = "";
        public string RefreshToken { get; set; } = "";
        public string Uid { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private async Task SignInWithProviderAsync(string providerName)
    {
        _error = null;
        _busy = true;
        _status = "Signing in...";
        try
        {
            var result = await JS.InvokeAsync<OAuthResult>("zpassAuth.signIn", AppConfig.FirebaseApiKey, AppConfig.FirebaseProjectId, providerName);
            var session = new FirebaseSession
            {
                IdToken = result.IdToken,
                RefreshToken = result.RefreshToken,
                LocalId = result.Uid,
                Email = result.Email,
                ExpiresAt = DateTimeOffset.UtcNow.AddMinutes(55)
            };
            var auth = new FirebaseAuthClient(AppConfig.FirebaseApiKey);
            AppState.SessionHolder = new SessionHolder(auth, session);
            AppState.Firestore = new FirestoreClient(AppConfig.FirebaseProjectId, AppState.SessionHolder.GetValidIdTokenAsync);
            Nav.NavigateTo("/unlock");
        }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("popup-closed-by-user") ? "Sign-in was cancelled." : $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _status = "";
        }
    }

    private async Task SendResetEmailAsync()
    {
        _error = null;
        _status = "";
        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "Enter your account email first.";
            return;
        }
        _busy = true;
        try
        {
            var auth = new FirebaseAuthClient(AppConfig.FirebaseApiKey);
            await auth.SendPasswordResetEmailAsync(_email.Trim());
            _status = $"If an account exists for {_email.Trim()}, a reset link has been sent — check your inbox.";
        }
        catch (FirebaseAuthException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Could not send the reset email: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
