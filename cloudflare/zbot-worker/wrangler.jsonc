{
  "name": "zpass-zbot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "routes": [{ "pattern": "botapi.zpas.org", "custom_domain": true }, { "pattern": "api.zpas.org", "custom_domain": true }],
  "vars": {
    "FIREBASE_PROJECT_ID": "passgram-org",
    "REQUIRE_APP_CHECK": "false"
  },
  "kv_namespaces": [{ "binding": "ZBOT_FILES", "id": "950cdde17b924a10862a1073419d3fa1" }],
  "observability": { "enabled": true },
  "account_id": "ceaaa7d98e5d8eddc066654306107a7b"
}
